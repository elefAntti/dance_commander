<!--
  Light palette: the same keys as Dark.xaml, and the same rules (§1.3). The chrome stays
  near-monochrome, the user owns colour through highlight rules, one accent, semantic red/amber.
  Not Dark.xaml inverted: on light, elevation reads as a step toward white, and colours that
  glowed on dark have to be darker to carry the same weight.

  Contrast, measured against PaneBrush (#FAFBFC): primary 16.3:1, secondary 7.9:1, muted 6.0:1,
  accent 5.8:1, danger 6.4:1, warning 5.7:1. On a selected row (SelectionActiveBrush) muted is
  still 4.8:1, so every text token clears WCAG AA everywhere it is drawn. PaletteContrastTests
  measures both palettes.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces: elevation, not outlines, separates regions; here a pane is a step toward white. -->
  <SolidColorBrush x:Key="WindowBrush" Color="#E9ECEF" />
  <SolidColorBrush x:Key="PaneBrush" Color="#FAFBFC" />
  <!-- The pane the keyboard is not in: a step back toward the window, as in the dark palette. -->
  <SolidColorBrush x:Key="PaneInactiveBrush" Color="#F2F4F6" />
  <SolidColorBrush x:Key="SunkenBrush" Color="#E2E6EA" />
  <SolidColorBrush x:Key="HoverBrush" Color="#E7EBF0" />
  <SolidColorBrush x:Key="DividerBrush" Color="#D3D8DE" />

  <!-- Popups: white, a step lighter than any surface they appear over, with the one outline. -->
  <SolidColorBrush x:Key="PopupBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="PopupBorderBrush" Color="#BCC3CB" />

  <!-- Text -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1D21" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#46505B" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="#58626C" />

  <!-- The single accent: darker than the dark palette's, which on white would barely show. -->
  <Color x:Key="AccentColor">#1F5FC7</Color>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="SelectionActiveBrush" Color="#D6E4FA" />
  <SolidColorBrush x:Key="SelectionInactiveBrush" Color="#E2E6EB" />

  <!-- The scroll bars' meeting corner, overriding the system key as Dark.xaml explains. -->
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#EDF0F3" />

  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#BCC3CB" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A3ABB4" />
  <SolidColorBrush x:Key="ScrollThumbActiveBrush" Color="#8C959F" />

  <!-- Git status marks: the same meanings, the shades light themes use for them. -->
  <SolidColorBrush x:Key="GitModifiedBrush" Color="#8A5A00" />
  <SolidColorBrush x:Key="GitAddedBrush" Color="#166F30" />
  <SolidColorBrush x:Key="GitDeletedBrush" Color="#C2272D" />
  <SolidColorBrush x:Key="GitUntrackedBrush" Color="#1765A8" />
  <SolidColorBrush x:Key="GitConflictBrush" Color="#A40E26" />

  <!-- Semantic only. Never decorative. -->
  <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
  <SolidColorBrush x:Key="WarningBrush" Color="#8A5A00" />
  <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FCE8E6" />
  <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FBF0D2" />
  <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#E3ECFA" />

</ResourceDictionary>
