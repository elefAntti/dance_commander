<!--
  The F-key legend. A legend, not a toolbar (§1.3): flat, quiet, no bevels, and it recedes until
  you hold a modifier — at which point it brightens and re-labels to show what those keys do now.
  It is the app teaching itself without a single tooltip.
-->
<UserControl x:Class="DanceCommander.App.Views.LegendBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DanceCommander.App.Views"
             FontFamily="{DynamicResource UiFontFamily}" MouseWheel="OnWheel"
             Foreground="{DynamicResource TextPrimaryBrush}">

  <UserControl.Resources>
    <Style x:Key="LegendKeyStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,5,0" />
    </Style>
    <Style x:Key="LegendTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- The held modifier, once, rather than "Ctrl+" in front of every key in the row. -->
    <TextBlock x:Name="ModifierLabel" Grid.Column="0" Style="{StaticResource LegendKeyStyle}"
               Margin="7,0,2,0" Text="{Binding HeldModifiersLabel}" Visibility="Collapsed" />

    <!-- One line, always: a layer with more keys than fit is paged (LegendPagePanel). -->
    <ItemsControl x:Name="Slots" Grid.Column="1" ItemsSource="{Binding Legend}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <views:LegendPagePanel Loaded="OnPanelLoaded" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Style="{StaticResource ChromeButtonStyle}" Padding="7,3" Margin="0,0,2,0"
                  Click="OnSlotClicked" Tag="{Binding CommandId}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Key}" Style="{StaticResource LegendKeyStyle}" />
              <TextBlock Text="{Binding Title}" Style="{StaticResource LegendTitleStyle}" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- There is more: a dot per line, the one on show brighter. Turns by itself while the key is
         held; tapping the key again, the wheel or a click turns it by hand. -->
    <Button x:Name="PageDots" Grid.Column="2" Style="{StaticResource ChromeButtonStyle}"
            Padding="6,3" VerticalAlignment="Center" Visibility="Collapsed"
            Click="OnDotsClicked" ToolTip="More keys: tap the key again, scroll, or click">
      <StackPanel x:Name="Dots" Orientation="Horizontal" />
    </Button>
  </Grid>
</UserControl>
