<Window x:Class="DanceCommander.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DanceCommander.App.Views"
        xmlns:conv="clr-namespace:DanceCommander.App.Converters"
        Title="{Binding WindowTitle}" Height="740" Width="1180" MinHeight="380" MinWidth="720"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource FontSizeBody}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <!-- Long copies show on the taskbar button, so the app need not be on screen to be watched. -->
  <Window.TaskbarItemInfo>
    <TaskbarItemInfo x:Name="Taskbar" ProgressValue="{Binding TaskbarProgress, Mode=OneWay}" />
  </Window.TaskbarItemInfo>

  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:BoolToVisibilityConverter x:Key="NotBoolToVisibility" Invert="True" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
  </Window.Resources>

  <Grid Margin="8,8,8,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LeftColumn" Width="*" MinWidth="220" />
        <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
        <ColumnDefinition x:Name="RightColumn" Width="*" MinWidth="220" />
      </Grid.ColumnDefinitions>

      <views:PaneView x:Name="LeftPane" Grid.Column="0" />

      <!-- Space is the separator; the splitter itself is invisible until you grab it. -->
      <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                    Background="Transparent" ShowsPreview="False" />

      <views:PaneView x:Name="RightPane" Grid.Column="2" />
    </Grid>

    <!--
      The job strip: transfers and builds, inside the status region rather than claiming a sixth
      one (§1.3, §6.17). It appears only while there is something to report and never blocks the
      panes above it.
    -->
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Jobs}" Margin="4,4,4,0"
                  Visibility="{Binding HasJobs, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,0,0,6">
            <!-- A forgotten job fades for JobFadesFor before it is removed (ShellViewModel). One
                 held for its first moments is not a row yet (JobShowsAfter). -->
            <Grid.Style>
              <Style TargetType="Grid">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsHeld}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsLeaving}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <DataTrigger.EnterActions>
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4" />
                        </Storyboard>
                      </BeginStoryboard>
                    </DataTrigger.EnterActions>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
              <!-- Title first and never trimmed; the detail (a file name, the line a build just
                   printed) takes what is left and gives way first. -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Where it runs, muted after the title: which worktree is building. -->
                <TextBlock Grid.Column="0" Style="{StaticResource SecondaryTextStyle}"
                           ToolTip="{Binding OriginPath}"><Run Text="{Binding Title, Mode=OneWay}" /><Run Text="{Binding OriginSuffix, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" /></TextBlock>
                <!-- A failed job with output says so here, in red, rather than in a surface below:
                     the output panel is already showing the same lines. -->
                <TextBlock Grid.Column="1" HorizontalAlignment="Right" Margin="16,0,0,0"
                           Text="{Binding Status}" TextTrimming="CharacterEllipsis" MaxWidth="560">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Failed">
                          <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <!-- The time left, muted after the status and never trimmed, so a long file name
                     gives way before it does. The speed is a hover away: it moves more than the
                     estimate does, and the strip stays calm. -->
                <TextBlock Grid.Column="2" Margin="8,0,0,0" Foreground="{DynamicResource TextMutedBrush}"
                           Text="{Binding Forecast, Mode=OneWay}" ToolTip="{Binding StatusTip, Mode=OneWay}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Forecast}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
              <!--
                A build cannot say how far along it is, so its bar says only that it is moving. A
                job that is waiting — queued, or on a question in the pane — is not moving, so its
                bar neither breathes nor keeps full strength: still and dim reads as paused.
              -->
              <ProgressBar Margin="0,3,0,0"
                           Value="{Binding Fraction, Mode=OneWay}"
                           IsIndeterminate="{Binding ShowsMotion, Mode=OneWay}">
                <ProgressBar.Style>
                  <Style TargetType="ProgressBar" BasedOn="{StaticResource ThinProgressStyle}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                        <Setter Property="Opacity" Value="0.4" />
                      </DataTrigger>
                      <!-- Stopped where it was cancelled: how far it got, still and dim, not a
                           bar that looks as if it might carry on. -->
                      <DataTrigger Binding="{Binding State}" Value="Cancelled">
                        <Setter Property="Opacity" Value="0.4" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ProgressBar.Style>
              </ProgressBar>
              <!--
                A failed transfer is usually more important than anything a pane reports, so it
                gets the same weight: a surface and a label, not a line of red text under a bar.
                Only for a job with no output of its own, though: a build's error is the tail of
                what it printed, which the output panel is showing already, and the same lines in
                two places at once was the clutter. The Output button brings the panel back.
              -->
              <Border Margin="0,6,0,0" Padding="9,6" CornerRadius="{DynamicResource RadiusS}"
                      Background="{DynamicResource DangerSurfaceBrush}">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Output}" Value="{x:Null}">
                        <Setter Property="Visibility"
                                Value="{Binding Error, Converter={StaticResource NullToVisibility}}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel>
                  <TextBlock Text="{Binding FailureHeadline}"
                             Foreground="{DynamicResource DangerBrush}" />
                  <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="0,2,0,0"
                             Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
              <!-- A job that finished with a result offers it; that is the file-manager ending to
                   a build, and why it beats a toast. Opens in the other pane. -->
              <Button Content="Open output folder" Style="{StaticResource ChromeButtonStyle}"
                      Click="OnOpenJobResult" Margin="0,0,4,0"
                      Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" />
              <!-- Back into the active pane, after the panel was dismissed or from the other pane. -->
              <Button Content="Output" Style="{StaticResource ChromeButtonStyle}"
                      Click="OnShowJobOutput" Margin="0,0,4,0"
                      ToolTip="Show what this job printed in the active pane"
                      Visibility="{Binding Output, Converter={StaticResource NullToVisibility}}" />
              <!-- The error is the part you paste into a ticket or a search; the panel found it
                   among the output, so taking it should not mean finding it again. -->
              <Button Content="Copy error" Style="{StaticResource ChromeButtonStyle}"
                      Click="OnCopyJobError" Margin="0,0,4,0"
                      Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" />
              <Button Content="{Binding ActionLabel}" Style="{StaticResource ChromeButtonStyle}"
                      Click="OnCancelJob"
                      Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!--
      What the window says for itself is about *operations*: the transfer strip above, and the
      log behind this button. Anything describing a location belongs to the pane showing it and
      lives in that pane's footer, so the count and the branch are not repeated here — which left
      the old status strip holding one button. It shares the legend's row instead; a permanent
      region for a single button is the chrome this application exists to avoid (§1.3). The legend
      is one line at every moment: a held modifier's layer is paged rather than wrapped
      (LegendPagePanel), so nothing above moves while a key is down.
    -->
    <Grid x:Name="StatusStrip" Grid.Row="2" Margin="2,0,4,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <views:LegendBar x:Name="Legend" Grid.Column="0" />

      <!--
        The echo (ShellViewModel.Echo): what just happened, beside the log it went into. Appears
        quickly, leaves slowly, and never moves anything — it only ever changes opacity.
      -->
      <views:StemSuffixPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0" MaxWidth="560"
                             Opacity="0" IsHitTestVisible="False">
        <views:StemSuffixPanel.Style>
          <Style TargetType="views:StemSuffixPanel">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsEchoing}" Value="True">
                <DataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.6" />
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.ExitActions>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </views:StemSuffixPanel.Style>
        <!-- The description trims; the offer to undo it does not (StemSuffixPanel). -->
        <TextBlock Text="{Binding Echo}" Style="{StaticResource SecondaryTextStyle}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding EchoUndo}" Style="{StaticResource SecondaryTextStyle}"
                   Foreground="{DynamicResource TextMutedBrush}" />
      </views:StemSuffixPanel>

      <!-- The shelf counts itself here while it has anything in it; a click shows it (§6.19). -->
      <Button x:Name="ShelfButton" Grid.Column="2" VerticalAlignment="Top" Margin="0,0,6,0"
              Style="{StaticResource ChromeButtonStyle}" Padding="6,1" Click="OnShelfClick"
              Visibility="{Binding HasShelf, Converter={StaticResource BoolToVisibility}}"
              ToolTip="Files marked across folders this session (Ctrl+B adds) — click to see them">
        <TextBlock>
          <Run Text="Shelf" /><Run Text=" " /><Run Text="{Binding ShelfCount, Mode=OneWay}" />
        </TextBlock>
      </Button>

      <Button x:Name="ActivityButton" Grid.Column="3" Content="Activity" VerticalAlignment="Top"
              Style="{StaticResource ChromeButtonStyle}" Padding="6,1"
              ToolTip="What this application has done to your files" />
    </Grid>

    <!-- Anchored to the whole strip, aligned right, so it can never spill off the window. -->
    <Popup x:Name="ActivityPopup" Placement="Top" PlacementTarget="{Binding ElementName=StatusStrip}"
           AllowsTransparency="True" StaysOpen="False" MaxHeight="420"
           Width="{Binding ActualWidth, ElementName=StatusStrip}">
      <ContentControl Style="{StaticResource PopupSurfaceStyle}" Padding="10" MinWidth="460" MaxWidth="820"
              Margin="0,0,0,4" HorizontalAlignment="Right">
        <StackPanel>
          <!-- The undo stack above the log: what Ctrl+Z does next, not only what was done. -->
          <StackPanel Margin="0,0,0,12" Visibility="{Binding HasUndo, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding UndoHeading}" Margin="0,0,0,6" />
            <ItemsControl x:Name="UndoList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Margin="0,0,0,3" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Description, Mode=OneWay}" /><Run Text="{Binding NoteSuffix, Mode=OneWay}"
                         Foreground="{DynamicResource TextMutedBrush}" />
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <TextBlock Text="Activity" Margin="0,0,0,6" />
          <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8"
                     Text="Nothing has happened yet."
                     Visibility="{Binding HasNoActivity, Converter={StaticResource BoolToVisibility}}" />
          <!-- No horizontal scrolling, so a long shell line wraps at the popup's width. -->
          <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ActivityList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="{Binding Description}" />
                    <TextBlock Text="{Binding ShellEquivalent}" Margin="0,2,0,0"
                               FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,2,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </ContentControl>
    </Popup>

    <!--
      The command palette (Ctrl+Shift+P): a third renderer over the one registry, alongside the
      F-key legend and the context menu (§1.2/1).

      It floats over the whole window rather than living in a pane, because a command is the
      window's business and the palette must not resize the thing you are about to act on. No
      scrim behind it: it is transient, not modal (§1.2/2) — clicking a pane moves the keyboard
      there and the palette simply leaves, with the click landing where it was aimed.
    -->
    <ContentControl x:Name="PaletteCard" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="10"
            Style="{StaticResource PopupSurfaceStyle}" Padding="10"
            Width="620" MaxHeight="440" Margin="0,64,0,0"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            DataContext="{Binding Palette}"
            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- An empty field that says nothing is a field you have to already know the use of.
             The hint lives inside the box's own template, in the same cell as the text area, so
             it starts exactly where typed text (and the caret) starts and cannot drift from it
             the way a sibling with a hand-counted margin did. The caret is drawn at the start of
             that area, so the hint is nudged a little right of it. -->
        <TextBox x:Name="PaletteQuery" Grid.Row="0" Style="{StaticResource InputStyle}"
                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                 PreviewKeyDown="OnPaletteKeyDown" LostKeyboardFocus="OnPaletteLostFocus">
          <TextBox.Template>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      CornerRadius="{DynamicResource RadiusS}"
                      BorderBrush="Transparent" BorderThickness="1">
                <Grid Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                  <ScrollViewer x:Name="PART_ContentHost" />
                  <TextBlock Text="Type to find a command" Margin="12,0,0,0" IsHitTestVisible="False"
                             FontFamily="{TemplateBinding FontFamily}"
                             FontSize="{TemplateBinding FontSize}"
                             VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                             Visibility="{Binding DataContext.HasQuery, ElementName=PaletteCard,
                                                  Converter={StaticResource NotBoolToVisibility}}" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </TextBox.Template>
        </TextBox>

        <!--
          Nothing in the list takes focus: the query box keeps the keyboard the whole time, the
          arrow keys move the highlight from there, and a click cannot pull focus out of the box
          and close the palette out from under itself. Same arrangement as the address bar's
          suggestions, and for the same reason.
        -->
        <ListBox x:Name="PaletteList" Grid.Row="1" Margin="0,6,0,0"
                 Background="Transparent" BorderThickness="0"
                 ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnPaletteSelectionChanged"
                 PreviewMouseLeftButtonUp="OnPaletteItemClicked">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="Focusable" Value="False" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Style.Triggers>
                <!-- A section header labels what follows; it is not something to choose, so it
                     takes no highlight and no click, and the arrow keys step over it (§6.18). -->
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                  <Setter Property="IsHitTestVisible" Value="False" />
                  <Setter Property="Padding" Value="5,10,5,3" />
                </DataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsHeader}" Value="True" />
                    <Condition Binding="{Binding IsFirst}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Padding" Value="5,2,5,3" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <!--
                  The header: the name of what the commands below act on — a file, "3 selected",
                  the folder with its icon and branch (the same chip as the footer), or the window.
                  A name rather than a category, because "what will this act on" is the question.
                -->
                <DockPanel Visibility="{Binding IsHeader, Converter={StaticResource BoolToVisibility}}">
                  <Border DockPanel.Dock="Right" Margin="12,0,2,0" Padding="7,1"
                          CornerRadius="{DynamicResource RadiusS}" Background="{DynamicResource HoverBrush}"
                          VerticalAlignment="Center"
                          Visibility="{Binding Branch, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" MaxWidth="220"
                               Text="{Binding Branch, StringFormat=⎇ {0}}" />
                  </Border>
                  <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16"
                         Margin="0,0,8,0" VerticalAlignment="Center"
                         Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}}" />
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </DockPanel>
                <Grid Visibility="{Binding IsHeader, Converter={StaticResource NotBoolToVisibility}}"
                      Margin="12,0,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <!-- Where the command came from: "File", "Git", or the tool's own group. -->
                <TextBlock Grid.Column="1" Text="{Binding Group}" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <!--
                  The key beside the title is half the reason this exists: every trip through the
                  palette is a chance to stop needing it. Monospace so the column reads as keys.
                -->
                <!-- Centred on the title's line: in the smaller type it otherwise rides above it. -->
                <TextBlock Grid.Column="2" Text="{Binding Binding}" Margin="16,0,2,0" MinWidth="104"
                           TextAlignment="Right" TextTrimming="None" VerticalAlignment="Center"
                           FontFamily="{DynamicResource MonoFontFamily}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- The list is filtered by where you are standing, and never silently (§1.3). -->
        <TextBlock Grid.Row="2" Margin="2,8,2,0" Text="{Binding Summary}"
                   Style="{StaticResource SecondaryTextStyle}" />
      </Grid>
    </ContentControl>

  </Grid>
</Window>
